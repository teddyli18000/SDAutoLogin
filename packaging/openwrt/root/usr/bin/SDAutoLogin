#!/bin/sh

# SDAutoLogin, kept compressed on the flash and unpacked into memory when it is
# needed: a router has little flash, the program is one large binary, and the
# package installs it gzipped (about 2.9 MiB of flash instead of 8.3). The copy
# under /tmp is unpacked on the first start after a boot and after an upgrade.
#
# Everything here runs as root and /tmp is a directory any account on the router
# can write to, so the unpack directory is treated as a place another account may
# have prepared: it has to be root's own, nobody else may write in it, and the
# program that is run has to be a regular file root owns that nobody else can
# write to either. A symbolic link on the way is refused rather than followed, and
# every tool is named by a full path, so PATH cannot decide what runs as root.
#
# The unpack directory is kept in /tmp because a router has no room for the
# program on its flash; the price is the checks above, which are the reason a
# prepared name here cannot become a program root runs. An account that manages to
# put its own directory at the name can still keep the service from starting by
# refusing to give it up, which is a denial of service and not a way in.

# The version is written here by the build task that makes the package,
# tools/build/pack_openwrt.go, and it is part of the name below. Every file in a
# package carries a fixed timestamp and /tmp is not cleared by an upgrade, so a
# name that changes with the version is what makes the new program unpack itself
# instead of running the copy of the old one.
version=@VERSION@

# Both paths are written here and in the build task as well.
archive=/usr/lib/sdautologin/SDAutoLogin.gz
prog_dir=/tmp/sdautologin
unpacked=$prog_dir/SDAutoLogin-$version

# A redirect to a name that already exists is refused rather than followed, so a
# symbolic link another account left at the name of the file being written cannot
# send the unpacked program somewhere else.
set -C

fail() {
	echo "SDAutoLogin: $1" >&2
	exit 1
}

# tool NAME: the full path of a tool. The directories searched are the ones only
# root may write to, which is what makes the path safe to run as root, and a name
# would instead be answered by whichever directory PATH happens to put first.
tool() {
	for dir in /bin /usr/bin /sbin /usr/sbin; do
		if [ -x "$dir/$1" ]; then
			echo "$dir/$1"
			return 0
		fi
	done
	return 1
}

LS=$(tool ls) || fail "ls is not installed"
RM=$(tool rm) || fail "rm is not installed"
MKDIR=$(tool mkdir) || fail "mkdir is not installed"
GUNZIP=$(tool gunzip) || fail "gunzip is not installed"
CHMOD=$(tool chmod) || fail "chmod is not installed"
MV=$(tool mv) || fail "mv is not installed"

# owned_by_root PATH KIND: true when PATH is root's own, has no write bit for the
# group or for anyone else, and is of the given kind (- for a regular file, d for
# a directory, which is what keeps a symbolic link out). stat is not part of every
# busybox build, so ls is asked instead: with -n its third and fourth columns are
# the numeric owner and group, and the first column of a long listing is the mode.
owned_by_root() {
	path=$1
	kind=$2
	set -- $("$LS" -lnd "$path" 2>/dev/null) || return 1
	[ $# -ge 4 ] || return 1
	case "$1" in
	"$kind"*) ;;
	*) return 1 ;;
	esac
	[ "$3" = 0 ] && [ "$4" = 0 ] || return 1
	# The write bit of the group and the one of everyone else, taken out of the
	# permission part of the mode, which is nine characters: three for the owner,
	# three for the group and three for everyone else.
	permissions=${1#?}
	group=${permissions#???}
	other=${permissions#??????}
	case "${group%???}" in ?w*) return 1 ;; esac
	case "$other" in ?w*) return 1 ;; esac
	return 0
}

# The unpack directory, made again when the name is not root's own directory.
if [ -L "$prog_dir" ]; then
	fail "$prog_dir is a symbolic link, refusing to unpack through it"
fi
if [ -e "$prog_dir" ] && ! owned_by_root "$prog_dir" d; then
	# Another account put something at the name. Root is the one account that can
	# take it away again, since the sticky bit of /tmp stops everyone else.
	echo "SDAutoLogin: $prog_dir is not root's own directory, clearing it" >&2
	"$RM" -rf "$prog_dir" || fail "cannot clear $prog_dir"
fi
if [ ! -d "$prog_dir" ]; then
	"$MKDIR" -m 0700 "$prog_dir" || fail "cannot make $prog_dir"
fi

if [ -x "$unpacked" ] && owned_by_root "$unpacked" -; then
	exec "$unpacked" "$@"
fi
if [ -e "$unpacked" ] || [ -L "$unpacked" ]; then
	echo "SDAutoLogin: $unpacked is not a file root alone can write, unpacking it again" >&2
	"$RM" -rf "$unpacked" || fail "cannot clear $unpacked"
fi

# Clear what an earlier run left in /tmp before another copy takes the room.
"$RM" -f "$prog_dir"/SDAutoLogin-*
# Unpacking goes to a name of our own that is moved into place afterwards, so
# that a second start cannot run half of a binary.
partial=$unpacked.$$
"$RM" -f "$partial"
if ! "$GUNZIP" -c "$archive" > "$partial"; then
	echo "SDAutoLogin: cannot unpack $archive, is there room in /tmp?" >&2
	"$RM" -f "$partial"
	exit 1
fi
owned_by_root "$partial" - || fail "$partial was not written by this run, refusing to run it"
"$CHMOD" 0755 "$partial" || fail "cannot make $partial executable"
"$MV" "$partial" "$unpacked" || fail "cannot move $partial into place"

exec "$unpacked" "$@"
