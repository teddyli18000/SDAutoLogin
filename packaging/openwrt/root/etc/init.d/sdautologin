#!/bin/sh /etc/rc.common

# SDAutoLogin as a service on OpenWrt.
#
# The account is read from /etc/config/sdautologin and handed to the program on
# every start, so it can also be written with "uci set" from a script:
#
#   uci set sdautologin.main.username=s1234567
#   uci set sdautologin.main.password=SECRET
#   uci commit sdautologin
#   /etc/init.d/sdautologin restart
#
# The password can also be kept in a file instead, which is the form to use when
# the account is written from a script or shared with another program:
#
#   printf '%s\n' SECRET > /etc/sdautologin/password
#   chmod 600 /etc/sdautologin/password
#   uci set sdautologin.main.password_file=/etc/sdautologin/password
#   uci commit sdautologin
#   /etc/init.d/sdautologin restart
#
# An option that is left empty is not passed on, and whatever config.json holds
# decides. The account can also be configured from the settings page: leave the
# account options here empty, turn the page on with the settings option below,
# and the page writes config.json on the overlay.

START=95

USE_PROCD=1

PROG=/usr/bin/SDAutoLogin
# config.json lives here, next to the settings page state. /etc sits on the
# overlay, so it survives a reboot and an upgrade, unlike the program itself,
# which the package keeps compressed in /usr/lib and unpacks into /tmp.
HOME_DIR=/etc/sdautologin

start_service() {
	config_load sdautologin

	local username password password_file isp settings log_file quiet
	config_get username main username
	config_get password main password
	config_get password_file main password_file
	config_get isp main isp
	config_get settings main settings
	config_get log_file main log_file
	config_get quiet main quiet

	set -- run "--home=$HOME_DIR"
	[ -n "$username" ] && set -- "$@" "--username=$username"
	# The file wins when both are set: a password on the command line is in the
	# process list, which every user on the router can read, and the program's own
	# help points at the file for that reason.
	if [ -n "$password_file" ]; then
		set -- "$@" "--password-file=$password_file"
	elif [ -n "$password" ]; then
		set -- "$@" "--password=$password"
	fi
	[ -n "$isp" ] && set -- "$@" "--isp=$isp"
	[ -n "$settings" ] && set -- "$@" "--settings=$settings"
	# The log file is off by default here, since /etc is on the flash and the
	# same lines already reach the system log in memory.
	[ "$log_file" = "0" ] && set -- "$@" "--no-log"
	# The console goes into the system log, and logd keeps a small ring: the
	# per check detail would be most of what it holds.
	[ "$quiet" != "0" ] && set -- "$@" "--quiet"

	procd_open_instance
	procd_set_param command "$PROG" "$@"
	# Restart after a crash, but stop retrying behind a wrong account: five
	# restarts, no more than one every five seconds.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sdautologin
}
