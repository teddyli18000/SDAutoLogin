#!/bin/sh

# Take the enable links out of the way, so that a removed package does not leave
# systemd with a unit it cannot find. The settings and the log in
# /var/lib/sdautologin are left alone: they hold an account.

if [ -x /usr/bin/deb-systemd-helper ]; then
	case "$1" in
	remove) deb-systemd-helper mask sdautologin.service >/dev/null || true ;;
	purge) deb-systemd-helper purge sdautologin.service >/dev/null || true ;;
	esac
fi
